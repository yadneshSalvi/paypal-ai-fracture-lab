# Copy to .env for a fresh checkout. Values below are examples or empty placeholders.
# Application-specific services and isolated PayPal apps are configured during implementation.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
PAYPAL_SANDBOX_SELLER_EMAIL=
PAYPAL_SANDBOX_SELLER_PASSWORD=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
AG_STUDIO_LICENSE_KEY=
BRYNTUM_LICENSE_KEY=
CHANNEL3_API_KEY=
CHANNEL3_API_BASE_URL=
CHANNEL3_HACKATHON_PROMO_CODE=

# Planned application configuration; not provisioned during planning.
APP_URL=
DATABASE_URL=
# Direct endpoint for the owner-only provider experiment lock when DATABASE_URL is pooled.
# Must use the same Neon endpoint, database and user. Never derive or rewrite credentials.
DATABASE_URL_UNPOOLED=
PAYPAL_WEBHOOK_ID=
OPENAI_MODEL=
GEMINI_MODEL=
SESSION_SECRET=
OBJECT_STORAGE_URL=
QUEUE_CONNECTION_URL=
DEMO_MODE=live

# Fracture application session and model investigation
JUDGE_SESSION_SECRET=
AUTH_SECRET=
CRON_SECRET=
OPENAI_PLANNER_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=max

FRACTURE_REPAIR_SNAPSHOT_ID=
FRACTURE_REPAIR_SNAPSHOT_HASH=
FRACTURE_REPAIR_SUITE_HASH=

# Tandem: qualified Vercel Python snapshot; no credentials enter the worker
TANDEM_RUNTIME_SNAPSHOT=
# Local fixed-source subprocess only; never enabled on Vercel
TANDEM_EXECUTION_MODE=

# Enable only after the live browser-approved runner passes local qualification.
FRACTURE_LIVE_BRAMBLE=

# Authorized local source inspection. Accepted sanitized source is copied into DATABASE_URL.
# Root aliases are trusted operator configuration; browser and tool arguments cannot set them.
# Example: [{"id":"checkout","directory":"/absolute/path/to/authorized/repository"}]
FRACTURE_SOURCE_ROOTS=
# Optional absolute trusted Python interpreter for bounded ast.parse inspection.
FRACTURE_SOURCE_PYTHON=
# Remote source storage requires explicit operator opt-in; local PostgreSQL is the default.
FRACTURE_SOURCE_REMOTE_PERSISTENCE=0
# Separately qualified imported-source Vercel Sandbox identity and fixed snapshot expiry.
# Keep generated-repair and imported-source snapshot identities distinct.
FRACTURE_SOURCE_EXECUTION_RUNNER_JSON=
FRACTURE_SOURCE_EXECUTION_SNAPSHOT_EXPIRES_AT=
