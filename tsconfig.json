{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@fracture/contracts": [
        "packages/contracts/src/index.ts"
      ],
      "@fracture/service": [
        "packages/service/src/index.ts"
      ],
      "@/*": [
        "apps/web/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "apps/web/.next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/.next",
    "**/dist",
    "**/.artifacts"
  ]
}
